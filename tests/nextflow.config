/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    // Local test data paths (no remote dependencies)
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'
}

// Test-specific profiles
profiles {
    gex_only {
        params {
            input = 'tests/samplesheet_gex_only.csv'
            run_gex = true
            run_dnam = false
            annotation_version = 'v107'
        }
    }

    dnam_precomputed {
        params {
            input = 'tests/samplesheet_dnam_precomputed.csv'
            run_gex = false
            run_dnam = true
            use_precomputed_dnam = true
        }
    }

    dnam_idat {
        params {
            input = 'tests/samplesheet_dnam_idat.csv'
            run_gex = false
            run_dnam = true
            use_precomputed_dnam = false
        }
    }

    dnam_mixed_invalid {
        params {
            input = 'tests/samplesheet_dnam_mixed_invalid.csv'
            run_gex = false
            run_dnam = true
        }
    }
}
