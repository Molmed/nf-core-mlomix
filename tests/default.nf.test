nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("GEX-only mode") {

        when {
            params {
                outdir = "$outputDir"
                input = 'tests/samplesheet_gex_only.csv'
                run_gex = true
                run_dnam = false
                annotation_version = 'v107'
            }
        }

        then {
            assertAll(
                { assert workflow.success }
            )
        }
    }

    test("DNAM-precomputed mode") {

        when {
            params {
                outdir = "$outputDir"
                input = 'tests/samplesheet_dnam_precomputed.csv'
                run_gex = false
                run_dnam = true
                use_precomputed_dnam = true
            }
        }

        then {
            assertAll(
                { assert workflow.success }
            )
        }
    }

    test("DNAM-IDAT mode") {

        when {
            params {
                outdir = "$outputDir"
                input = 'tests/samplesheet_dnam_idat.csv'
                run_gex = false
                run_dnam = true
                use_precomputed_dnam = false
            }
        }

        then {
            assertAll(
                { assert workflow.success }
            )
        }
    }

    test("Invalid mixed DNAM mode (should fail)") {

        when {
            params {
                outdir = "$outputDir"
                input = 'tests/samplesheet_dnam_mixed_invalid.csv'
                run_gex = false
                run_dnam = true
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stderr.contains("different dnam modes") || workflow.stderr.contains("DNAM") }
            )
        }
    }
}
