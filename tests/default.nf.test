nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("GEX-only mode") {

        when {
            params {
                outdir = "$outputDir"
                input = 'tests/samplesheet_gex_only.csv'
                run_gex = true
                run_dnam = false
                annotation_version = 'v107'
                skip_umaps = true
            }
        }

        then {
            assertAll(
                { assert workflow.success }
            )
        }
    }

    test("DNAM-precomputed mode") {

        when {
            params {
                outdir = "$outputDir"
                input = 'tests/samplesheet_dnam_precomputed.csv'
                run_gex = false
                run_dnam = true
                use_precomputed_dnam = true
            }
        }

        then {
            assertAll(
                { assert workflow.success }
            )
        }
    }

    test("DNAM-precomputed beta-only mode") {

        when {
            params {
                outdir = "$outputDir"
                input = 'tests/samplesheet_dnam_precomputed_beta_only.csv'
                run_gex = false
                run_dnam = true
                use_precomputed_dnam = true
            }
        }

        then {
            assertAll(
                { assert workflow.success }
            )
        }
    }

    test("DNAM-IDAT mode") {

        when {
            params {
                outdir = "$outputDir"
                input = 'tests/samplesheet_dnam_idat.csv'
                run_gex = false
                run_dnam = true
                use_precomputed_dnam = false
                skip_umaps = true
            }
        }

        then {
            assertAll(
                { assert workflow.success }
            )
        }
    }

    test("Mixed: GEX + DNAM-precomputed + DNAM-IDAT (valid)") {

        when {
            params {
                outdir = "$outputDir"
                input = 'tests/samplesheet_mixed_all_modes.csv'
                run_gex = true
                run_dnam = true
                annotation_version = 'v107'
            }
        }

        then {
            assertAll(
                { assert workflow.success }
            )
        }
    }

    test("Invalid: single sample mixing DNAM modes (should fail)") {

        when {
            params {
                outdir = "$outputDir"
                input = 'tests/samplesheet_invalid_single_sample_mixed.csv'
                run_gex = false
                run_dnam = true
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.stderr.contains("mixes precomputed and IDAT modes") }
            )
        }
    }
}
