{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/mlomix/main/assets/schema_input.json",
    "title": "nf-core/mlomix pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "dataset": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Dataset name must be provided and cannot contain spaces",
                "meta": ["dataset"]
            },
            "batch": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Batch cannot contain spaces",
                "meta": ["batch"],
                "default": null
            },
            "class": {
                "type": "string",
                "meta": ["class"],
                "default": null
            },
            "data_silo": {
                "type": "string",
                "meta": ["data_silo"],
                "default": null
            },
            "gex_feature_counts_file": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "errorMessage": "gex_feature_counts_file must be a valid file path",
                "meta": ["gex_feature_counts_file"],
                "default": null
            },
            "dnam_beta_matrix_file": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "errorMessage": "dnam_beta_matrix_file must be a valid file path",
                "meta": ["dnam_beta_matrix_file"],
                "default": null
            },
            "dnam_pvals_file": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "errorMessage": "dnam_pvals_file must be a valid file path",
                "meta": ["dnam_pvals_file"],
                "default": null
            },
            "sentrix_id": {
                "type": ["string", "integer"],
                "errorMessage": "sentrix_id must be a string or integer",
                "meta": ["sentrix_id"],
                "default": null
            },
            "sentrix_position": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "sentrix_position cannot contain spaces",
                "meta": ["sentrix_position"],
                "default": null
            },
            "idats_basename": {
                "type": "string",
                "format": "directory-path",
                "exists": true,
                "errorMessage": "idats_basename must be a valid directory path",
                "meta": ["idats_basename"],
                "default": null
            }
        },
        "dependentRequired": {
            "dnam_pvals_file": [
                "dnam_beta_matrix_file"
            ]
        },
        "required": ["sample", "dataset"],
        "allOf": [
            {
                "if": {
                    "not": {
                        "required": ["gex_feature_counts_file"]
                    }
                },
                "then": {
                    "anyOf": [
                        {
                            "required": ["dnam_beta_matrix_file"]
                        },
                        {
                            "required": ["sentrix_id", "sentrix_position", "idats_basename"]
                        }
                    ]
                }
            }
        ]
    }
}
